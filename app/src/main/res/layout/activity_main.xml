<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_decorations"
    tools:context=".MainActivity">

    <!-- Calculator Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/calc_title"
        android:textColor="@color/text_white"
        android:textSize="32sp"
        android:textStyle="italic"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- History Access Button -->
    <ImageButton
        android:id="@+id/btnHistory"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="24dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="History"
        android:src="@android:drawable/ic_menu_recent_history"
        app:tint="@color/text_white"
        app:layout_constraintBottom_toBottomOf="@id/tvTitle"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tvTitle" />

    <!-- Transparent Display Screen -->
    <LinearLayout
        android:id="@+id/displayLayout"
        android:layout_width="0dp"
        android:layout_height="110dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_display"
        android:elevation="6dp"
        android:gravity="end|bottom"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">

            <TextView
                android:id="@+id/tvExpression"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="end"
                android:singleLine="true"
                android:textColor="#D1C4E9"
                android:textSize="18sp" />
        </HorizontalScrollView>

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fillViewport="true"
            android:scrollbars="none">

            <TextView
                android:id="@+id/tvResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:gravity="end"
                android:singleLine="true"
                android:text="@string/zero"
                android:textColor="@color/text_white"
                android:textSize="44sp"
                android:textStyle="bold" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Calculator Buttons Grid -->
    <GridLayout
        android:id="@+id/gridLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="24dp"
        android:columnCount="4"
        android:rowCount="5"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/displayLayout">

    <!-- Row 1: AC, Delete, %, Division -->
    <Button
        android:id="@+id/btnAc"
        style="@null"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_columnWeight="1"
        android:layout_gravity="fill_horizontal"
        android:layout_margin="6dp"
        android:background="@drawable/bg_button"
        android:backgroundTint="#EBDFFF"
        android:text="@string/ac"
        android:textColor="@color/text_dark"
        android:textSize="22sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnDel"
        style="@null"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_columnWeight="1"
        android:layout_gravity="fill_horizontal"
        android:layout_margin="6dp"
        android:background="@drawable/bg_button"
        android:backgroundTint="@null"
        android:text="DEL"
        android:textColor="@color/text_dark"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp" />

    <Button
        android:id="@+id/btnPercent"
        style="@null"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_columnWeight="1"
        android:layout_gravity="fill_horizontal"
        android:layout_margin="6dp"
        android:background="@drawable/bg_button"
        android:backgroundTint="@null"
        android:text="@string/percent"
        android:textColor="@color/text_dark"
        android:textSize="22sp" />

    <Button
        android:id="@+id/btnDiv"
        style="@null"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_columnWeight="1"
        android:layout_gravity="fill_horizontal"
        android:layout_margin="6dp"
        android:background="@drawable/bg_button"
        android:backgroundTint="@null"
        android:text="@string/div"
        android:textColor="@color/text_dark"
        android:textSize="24sp" />

    <!-- Row 2: 7, 8, 9, Multiplication -->
    <Button
        android:id="@+id/btn7"
        style="@null"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_columnWeight="1"
        android:layout_gravity="fill_horizontal"
        android:layout_margin="6dp"
        android:background="@drawable/bg_button"
        android:backgroundTint="@null"
        android:text="@string/seven"
        android:textColor="@color/text_dark"
        android:textSize="24sp" />

    <Button
        android:id="@+id/btn8"
        style="@null"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_columnWeight="1"
        android:layout_gravity="fill_horizontal"
        android:layout_margin="6dp"
        android:background="@drawable/bg_button"
        android:backgroundTint="@null"
        android:text="@string/eight"
        android:textColor="@color/text_dark"
        android:textSize="24sp" />

    <Button
        android:id="@+id/btn9"
        style="@null"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_columnWeight="1"
        android:layout_gravity="fill_horizontal"
        android:layout_margin="6dp"
        android:background="@drawable/bg_button"
        android:backgroundTint="@null"
        android:text="@string/nine"
        android:textColor="@color/text_dark"
        android:textSize="24sp" />

    <Button
        android:id="@+id/btnMul"
        style="@null"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_columnWeight="1"
        android:layout_gravity="fill_horizontal"
        android:layout_margin="6dp"
        android:background="@drawable/bg_button"
        android:backgroundTint="@null"
        android:text="@string/mul"
        android:textColor="@color/text_dark"
        android:textSize="24sp" />

    <!-- Row 3: 4, 5, 6, Subtraction -->
    <Button
        android:id="@+id/btn4"
        style="@null"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_columnWeight="1"
        android:layout_gravity="fill_horizontal"
        android:layout_margin="6dp"
        android:background="@drawable/bg_button"
        android:backgroundTint="@null"
        android:text="@string/four"
        android:textColor="@color/text_dark"
        android:textSize="24sp" />

    <Button
        android:id="@+id/btn5"
        style="@null"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_columnWeight="1"
        android:layout_gravity="fill_horizontal"
        android:layout_margin="6dp"
        android:background="@drawable/bg_button"
        android:backgroundTint="@null"
        android:text="@string/five"
        android:textColor="@color/text_dark"
        android:textSize="24sp" />

    <Button
        android:id="@+id/btn6"
        style="@null"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_columnWeight="1"
        android:layout_gravity="fill_horizontal"
        android:layout_margin="6dp"
        android:background="@drawable/bg_button"
        android:backgroundTint="@null"
        android:text="@string/six"
        android:textColor="@color/text_dark"
        android:textSize="24sp" />

    <Button
        android:id="@+id/btnSub"
        style="@null"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_columnWeight="1"
        android:layout_gravity="fill_horizontal"
        android:layout_margin="6dp"
        android:background="@drawable/bg_button"
        android:backgroundTint="@null"
        android:text="@string/sub"
        android:textColor="@color/text_dark"
        android:textSize="28sp" />

    <!-- Row 4: 1, 2, 3, Addition -->
    <Button
        android:id="@+id/btn1"
        style="@null"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_columnWeight="1"
        android:layout_gravity="fill_horizontal"
        android:layout_margin="6dp"
        android:background="@drawable/bg_button"
        android:backgroundTint="@null"
        android:text="@string/one"
        android:textColor="@color/text_dark"
        android:textSize="24sp" />

    <Button
        android:id="@+id/btn2"
        style="@null"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_columnWeight="1"
        android:layout_gravity="fill_horizontal"
        android:layout_margin="6dp"
        android:background="@drawable/bg_button"
        android:backgroundTint="@null"
        android:text="@string/two"
        android:textColor="@color/text_dark"
        android:textSize="24sp" />

    <Button
        android:id="@+id/btn3"
        style="@null"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_columnWeight="1"
        android:layout_gravity="fill_horizontal"
        android:layout_margin="6dp"
        android:background="@drawable/bg_button"
        android:backgroundTint="@null"
        android:text="@string/three"
        android:textColor="@color/text_dark"
        android:textSize="24sp" />

    <Button
        android:id="@+id/btnAdd"
        style="@null"
        android:layout_width="0dp"
        android:layout_height="70dp"
        android:layout_columnWeight="1"
        android:layout_gravity="fill_horizontal"
        android:layout_margin="6dp"
        android:background="@drawable/bg_button"
        android:backgroundTint="@null"
        android:text="@string/add"
        android:textColor="@color/text_dark"
        android:textSize="26sp" />


        <!-- Row 5: 0, Decimal, Equal -->
        <Button
            android:id="@+id/btn0"
            style="@null"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_columnWeight="2"
            android:layout_gravity="fill_horizontal"
            android:layout_margin="6dp"
            android:background="@drawable/bg_button"
            android:backgroundTint="@null"
            android:text="@string/zero"
            android:textColor="@color/text_dark"
            android:textSize="24sp" />

        <Button
            android:id="@+id/btnDot"
            style="@null"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_columnWeight="1"
            android:layout_gravity="fill_horizontal"
            android:layout_margin="6dp"
            android:background="@drawable/bg_button"
            android:backgroundTint="@null"
            android:text="@string/dot"
            android:textColor="@color/text_dark"
            android:textSize="28sp" />

        <Button
            android:id="@+id/btnEqual"
            style="@null"
            android:layout_width="0dp"
            android:layout_height="70dp"
            android:layout_columnSpan="2"
            android:layout_gravity="fill_horizontal"
            android:layout_margin="6dp"
            android:background="@drawable/bg_button_equal"
            android:backgroundTint="@null"
            android:text="@string/equal"
            android:textColor="@color/text_dark"
            android:textSize="28sp" />


    </GridLayout>

    <!-- Top decorative elements -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="☁️  ✨  🦋"
        android:textSize="25sp"
        android:alpha="0.85"
        android:layout_marginStart="20dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Left decorative cloud -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="☁️"
        android:textSize="38sp"
        android:alpha="0.55"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="25dp"
        android:layout_marginBottom="75dp" />

    <!-- Right decorative cloud -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="☁️"
        android:textSize="30sp"
        android:alpha="0.45"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginEnd="30dp"
        android:layout_marginBottom="115dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
